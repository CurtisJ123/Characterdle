{
  "name": "characterdle",
  "main": "./dist-ssr/worker.js",
  "compatibility_date": "2026-06-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/updates", "/updates/*"],
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true
}
